# Copia este archivo a .env y cambia las contraseñas (sin espacios ni comillas).
# .env está en .gitignore: no se sube a Git.
PORT=3000
MQTT_URL=mqtt://localhost:1883
MQTT_USER_BACKEND=backend
MQTT_PASS_BACKEND=cambia-esta-clave-1
MQTT_USER_DISP=dispositivo
MQTT_PASS_DISP=cambia-esta-clave-2
MONGO_URL=mongodb://localhost:27017/bomba
